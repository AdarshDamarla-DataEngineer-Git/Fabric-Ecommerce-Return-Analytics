        "dependsOn": []
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "watermark_year",
          "value": {
            "value": "@if(\n    and(\n        not(empty(pipeline().parameters.reprocess_year)),\n        not(empty(pipeline().parameters.reprocess_month))\n    ),\n    pipeline().parameters.reprocess_year,\n    if(\n        equals(\n            int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n            12\n        ),\n        string(\n            add(\n                int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Year),\n                1\n            )\n        ),\n        string(\n            activity('Lookup_Watermark').output.firstRow.Last_Processed_Year\n        )\n    )\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set_watermark_year",
        "dependsOn": [
          {
            "activity": "Lookup_Watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "watermark_month",
          "value": {
            "value": "@if(\n    and(\n        not(empty(pipeline().parameters.reprocess_year)),\n        not(empty(pipeline().parameters.reprocess_month))\n    ),\n    if(\n        less(length(pipeline().parameters.reprocess_month), 2),\n        concat('0', pipeline().parameters.reprocess_month),\n        pipeline().parameters.reprocess_month\n    ),\n    if(\n        equals(\n            int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n            12\n        ),\n        '01',\n        if(\n            less(\n                add(\n                    int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                    1\n                ),\n                10\n            ),\n            concat(\n                '0',\n                string(\n                    add(\n                        int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                        1\n                    )\n                )\n            ),\n            string(\n                add(\n                    int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                    1\n                )\n            )\n        )\n    )\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set_watermark_month",
        "dependsOn": [
          {
            "activity": "Lookup_Watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
