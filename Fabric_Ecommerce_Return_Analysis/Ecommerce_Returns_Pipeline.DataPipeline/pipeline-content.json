      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "watermark_month",
          "value": {
            "value": "@if(\n    equals(\n        int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n        12\n    ),\n    '01',\n    if(\n        less(\n            add(\n                int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                1\n            ),\n            10\n        ),\n        concat(\n            '0',\n            string(\n                add(\n                    int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                    1\n                )\n            )\n        ),\n        string(\n            add(\n                int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n                1\n            )\n        )\n    )\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
