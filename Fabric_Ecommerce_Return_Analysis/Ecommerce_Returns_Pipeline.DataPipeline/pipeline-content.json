        "type": "SetVariable",
        "typeProperties": {
          "variableName": "watermark_month_name",
          "value": {
            "value": "@formatDateTime(\n    concat(\n        variables('watermark_year'),\n        '-',\n        variables('watermark_month'),\n        '-01'\n    ),\n    'MMMM'\n)",
            "type": "Expression"
