      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "watermark_year",
          "value": {
            "value": "@if(\n    equals(\n        int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Month),\n        12\n    ),\n    string(\n        add(\n            int(activity('Lookup_Watermark').output.firstRow.Last_Processed_Year),\n            1\n        )\n    ),\n    string(\n        activity('Lookup_Watermark').output.firstRow.Last_Processed_Year\n    )\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
